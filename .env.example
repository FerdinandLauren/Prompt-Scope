# PromptScope - environment example
# Copy this file to .env.local and fill in values there.
# Never commit .env.local or a real API key.
#
# This file is the only env file tracked by git and it must never contain a
# secret. A key entered in the Settings UI stays in the browser; it is not a
# replacement for this variable and must not be added here.

# Required for Live AI Mode. Leave empty to run in Demo Mode.
# Obtain a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Must be a Gemini model that supports structured JSON output.
# Defaults to gemini-3.6-flash when omitted. If that model answers 503 (high
# demand), the app retries once with GEMINI_FALLBACK_MODEL.
# Verify current models at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# Optional. Used once when the primary model is busy. Defaults to
# gemini-4-hydrogen. Set to "none" to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen

# Optional. Per-IP AI request ceiling and window for the in-process limiter.
# Defaults: 12 requests per 60000 ms. Raise the limit only for local testing.
AI_RATE_LIMIT_MAX=12
AI_RATE_LIMIT_WINDOW_MS=60000
