# PromptScope - environment example
# Copy this file to .env.local and fill in values there.
# Never commit .env.local or a real API key.
#
# This file is the only env file tracked by git and it must never contain a
# secret. A key entered in the Settings UI stays in the browser; it is not a
# replacement for this variable and must not be added here.

# Required for Live AI Mode. Leave empty to run in Demo Mode.
# Obtain a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Must be a Gemini model that supports structured JSON output.
# Defaults to gemini-3.6-flash when omitted. If that model answers 503 (high
# demand), the app retries once with GEMINI_FALLBACK_MODEL.
# Verify current models at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.6-flash

# Optional. Used once when the primary model is busy. Defaults to
# gemini-4-hydrogen. Set to "none" to disable the fallback.
GEMINI_FALLBACK_MODEL=gemini-4-hydrogen

# Optional. Extra Gemini model ids for the Settings model picker, comma
# separated. These are suggestions only; the provider still validates them.
GEMINI_MODELS=

# ---------------------------------------------------------------------------
# Vikey (OpenAI-compatible). Verified docs: https://docs.vikey.ai
# ---------------------------------------------------------------------------
# Leave empty to keep Vikey disabled. A key entered in Settings overrides this
# value for that browser only.
VIKEY_API_KEY=
# Defaults to https://api.vikey.ai/v1 when omitted. Must be an https URL.
VIKEY_BASE_URL=https://api.vikey.ai/v1
# Defaults to vikey/agent-gpt (documented auto-routing model).
VIKEY_MODEL=vikey/agent-gpt

# ---------------------------------------------------------------------------
# Dattio (opt-in, unverified). No official public API documentation could be
# verified, so PromptScope does not guess an endpoint or model. Supply both
# values from your Dattio account to enable this provider.
# ---------------------------------------------------------------------------
DATTIO_API_KEY=
DATTIO_BASE_URL=
DATTIO_MODEL=

# ---------------------------------------------------------------------------
# Routing. Settings in the UI override these values. Defaults keep today's
# behaviour: prefer Gemini, switch on transient failures.
# ---------------------------------------------------------------------------
# manual | auto | auto_fallback (default)
AI_ROUTING_MODE=auto_fallback
# Comma-separated provider order for automatic selection and fallback.
# Known ids: gemini, vikey, dattio
AI_PROVIDER_ORDER=gemini,vikey,dattio
# auto or a provider id.
AI_PREFERRED_PROVIDER=auto
# true | false. Controls whether a transient failure may switch providers.
AI_FALLBACK_ENABLED=true
# Optional fixed provider/model for manual mode.
AI_MANUAL_PROVIDER=
AI_MANUAL_MODEL=

# Optional. Per-IP AI request ceiling and window for the in-process limiter.
# Defaults: 12 requests per 60000 ms. Raise the limit only for local testing.
AI_RATE_LIMIT_MAX=12
AI_RATE_LIMIT_WINDOW_MS=60000
